    village_condo_ratio_2010 = if_else(
      households_2010 > 0,
      village_condo_2010 / households_2010,
      NA_real_
    )
  )

# ------------------------------------------------------------
# 5. Aggregate 2022 counts and calculate proportion
# ------------------------------------------------------------

village_condo_2022_common <- village_condo_lookup_2022 %>%
  left_join(village_condo_2022, by = "id_2022") %>%
  group_by(common_id) %>%
  summarise(
    households_2022 = if (all(is.na(households_2022))) {
      NA_real_
    } else {
      sum(households_2022, na.rm = TRUE)
    },
    village_condo_2022 = sum(village_condo_2022, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    village_condo_ratio_2022 = if_else(
      households_2022 > 0,
      village_condo_2022 / households_2022,
      NA_real_
    )
  )

# ------------------------------------------------------------
# 6. Join years and calculate change
# ------------------------------------------------------------

village_condo_change <- village_condo_2010_common %>%
  full_join(village_condo_2022_common, by = "common_id") %>%
  mutate(
    village_condo_ratio_change =
      village_condo_ratio_2022 - village_condo_ratio_2010,
    village_condo_ratio_change_pp =
      village_condo_ratio_change * 100
  )

# ------------------------------------------------------------
# 7. Attach values to 2022 geometry
# ------------------------------------------------------------

village_condo_fields <- c(
  "households_2010", "village_condo_2010",
  "village_condo_ratio_2010",
  "households_2022", "village_condo_2022",
  "village_condo_ratio_2022",
  "village_condo_ratio_change", "village_condo_ratio_change_pp"
)

village_condo_change_sf <- base_geom_2022 %>%
  mutate(common_id = as.character(common_id)) %>%
  select(-any_of(village_condo_fields)) %>%
  left_join(village_condo_change, by = "common_id")

# ------------------------------------------------------------
# 8. Separate annual sf objects
# ------------------------------------------------------------

village_condo_2010_sf <- base_geom_2022 %>%
  mutate(common_id = as.character(common_id)) %>%
  select(-any_of(village_condo_fields)) %>%
  left_join(village_condo_2010_common, by = "common_id")

village_condo_2022_sf <- base_geom_2022 %>%
  mutate(common_id = as.character(common_id)) %>%
  select(-any_of(village_condo_fields)) %>%
  left_join(village_condo_2022_common, by = "common_id")

# ------------------------------------------------------------
# 9. Check results
# ------------------------------------------------------------

summary(village_condo_change$village_condo_ratio_change_pp)

village_condo_change %>%
  summarise(
    missing_2010 = sum(is.na(village_condo_ratio_2010)),
    missing_2022 = sum(is.na(village_condo_ratio_2022)),
    missing_change = sum(is.na(village_condo_ratio_change))
  )

# Should return zero rows
village_condo_change %>%
  filter(
    village_condo_ratio_2010 < 0 | village_condo_ratio_2010 > 1 |
      village_condo_ratio_2022 < 0 | village_condo_ratio_2022 > 1
  )

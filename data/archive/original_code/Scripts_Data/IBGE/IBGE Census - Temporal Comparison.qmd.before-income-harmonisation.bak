stopifnot(
  !anyDuplicated(village_condo_2010$id_2010),
  !anyDuplicated(village_condo_2022$id_2022),
  !anyDuplicated(village_condo_lookup_2010$id_2010),
  !anyDuplicated(village_condo_lookup_2022$id_2022)
)

# ------------------------------------------------------------
# 4. Aggregate 2010 counts and calculate proportion

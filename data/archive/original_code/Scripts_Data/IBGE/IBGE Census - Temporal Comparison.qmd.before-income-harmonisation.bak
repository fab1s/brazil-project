```{r brown_sf}
library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 and 2022 data
# ------------------------------------------------------------

brown_2010 <- census_data_2010_pessoa %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    pop_2010 = pessoa03_V001,
    brown_pop_2010 = pessoa03_V005
  )

brown_2022 <- census_data_2022_basico %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    pop_2022 = V0001
  ) %>%
  left_join(
    census_data_2022_pessoas %>%
      st_drop_geometry() %>%
      transmute(
        id_2022 = as.character(code_tract),
        brown_pop_2022 = raca_V01320
      ),
    by = "id_2022"
  )


# ------------------------------------------------------------
# 2. Prepare and check lookup tables
# ------------------------------------------------------------

brown_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id
  ) %>%
  distinct()

brown_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id
  ) %>%
  distinct()

stopifnot(
  !anyDuplicated(brown_2010$id_2010),
  !anyDuplicated(brown_2022$id_2022),
  !anyDuplicated(brown_lookup_2010$id_2010),
  !anyDuplicated(brown_lookup_2022$id_2022),
  !anyDuplicated(group_sizes$common_id)
)


# ------------------------------------------------------------
# 3. Aggregate 2010 counts, then calculate proportion
#
# Missing counts are ignored during aggregation (na.rm = TRUE).
# ------------------------------------------------------------

brown_2010_common <- brown_2010 %>%
  left_join(
    brown_lookup_2010,
    by = "id_2010"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    pop_2010 = sum(pop_2010, na.rm = TRUE),
    brown_pop_2010 = sum(brown_pop_2010, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    brown_ratio_2010 = if_else(
      pop_2010 > 0,
      brown_pop_2010 / pop_2010,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 4. Aggregate 2022 counts, then calculate proportion
# ------------------------------------------------------------

brown_2022_common <- brown_2022 %>%
  left_join(
    brown_lookup_2022,
    by = "id_2022"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    pop_2022 = sum(pop_2022, na.rm = TRUE),
    brown_pop_2022 = sum(brown_pop_2022, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    brown_ratio_2022 = if_else(
      pop_2022 > 0,
      brown_pop_2022 / pop_2022,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 5. Join years and calculate change
#
# Positive = higher Brown population share in 2022
# ------------------------------------------------------------

brown_change <- brown_2010_common %>%
  full_join(
    brown_2022_common,
    by = "common_id"
  ) %>%
  left_join(
    group_sizes %>%
      select(common_id, n_2010, n_2022, relationship),
    by = "common_id"
  ) %>%
  mutate(
    brown_ratio_change = brown_ratio_2022 - brown_ratio_2010,
    brown_ratio_change_pp = brown_ratio_change * 100
  )


# ------------------------------------------------------------
# 6. Attach proportions and change to 2022 geometry
# ------------------------------------------------------------

brown_sf <- base_geom_2022 %>%
  select(-any_of(c("pop_2010", "brown_pop_2010", "brown_ratio_2010", "pop_2022", "brown_pop_2022", "brown_ratio_2022", "brown_ratio_change", "brown_ratio_change_pp"))) %>%
  left_join(
    brown_change %>%
      select(
        common_id,
        pop_2010,
        brown_pop_2010,
        brown_ratio_2010,
        pop_2022,
        brown_pop_2022,
        brown_ratio_2022,
        brown_ratio_change,
        brown_ratio_change_pp
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 7. Separate sf objects for each year
#
# Both use 2022 geometry and common_id-level proportions.
# ------------------------------------------------------------

brown_2010_sf <- base_geom_2022 %>%
  select(-any_of(c("pop_2010", "brown_pop_2010", "brown_ratio_2010", "pop_2022", "brown_pop_2022", "brown_ratio_2022", "brown_ratio_change", "brown_ratio_change_pp"))) %>%
  left_join(brown_2010_common, by = "common_id")

brown_2022_sf <- base_geom_2022 %>%
  select(-any_of(c("pop_2010", "brown_pop_2010", "brown_ratio_2010", "pop_2022", "brown_pop_2022", "brown_ratio_2022", "brown_ratio_change", "brown_ratio_change_pp"))) %>%
  left_join(brown_2022_common, by = "common_id")


# ------------------------------------------------------------
# 8. Check results
# ------------------------------------------------------------

summary(brown_change$brown_ratio_change_pp)

brown_change %>%
  count(relationship)

brown_change %>%
  summarise(
    missing_2010 = sum(is.na(brown_ratio_2010)),
    missing_2022 = sum(is.na(brown_ratio_2022)),
    missing_change = sum(is.na(brown_ratio_change))
  )

# Inspect out-of-range proportions; these are not automatically removed.
brown_change %>%
  filter(
    brown_ratio_2010 < 0 |
      brown_ratio_2010 > 1 |
      brown_ratio_2022 < 0 |
      brown_ratio_2022 > 1
  )
```


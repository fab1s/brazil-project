village_condo_2010 <- census_data_2010_domicilio %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    households_2010 = domicilio01_V002,
    village_condo_2010 = domicilio01_V004
  )

# ------------------------------------------------------------
# 2. Prepare 2022 data

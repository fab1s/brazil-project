#code in progress

```{r libraries}
#| message: false

library(sf)
library(dplyr)
library(readr)

library(censobr) # for IBGE's census data
```

## Black population

```{r data_import}
#| warning: false
#| message: false

## 2010
census_data_2010_pessoa <- read_tracts(
  year = 2010,
  dataset = "Pessoa",
  as_data_frame = TRUE
)

census_data_2010_domicilio <- read_tracts(
  year = 2010,
  dataset = "Domicilio",
  as_data_frame = TRUE
)


## 2022
census_data_2022_basico <- read_tracts(
  year = 2022,
  dataset = "Basico",
  as_data_frame = TRUE
)

census_data_2022_pessoas <- read_tracts(
  year = 2022,
  dataset = "Pessoas",
  as_data_frame = TRUE
)
  
census_data_2022_domicilios <- read_tracts(
  year = 2022,
  dataset = "Domicilio",
  as_data_frame = TRUE
) 

lookup_2010 <- st_read("IBGE/Data/lookup.gpkg", layer = "2010")
lookup_2022 <- st_read("IBGE/Data/lookup.gpkg", layer = "2022")

group_sizes <- read_csv("IBGE/Data/group_sizes.csv")
base_geom_2022 <- st_read("IBGE/Data/base_geometry_2022.gpkg")
```

## Calculation conventions

All eight indicators retain available annual common-area estimates with `full_join()`. Counts are summed with `na.rm = TRUE`; missing components of combined counts are also treated as zero before addition. This preserves the requested Black-only aggregation approach, but incomplete counts can bias proportions. Ratios with zero total population/households remain unavailable. An absent year is never filled with zero, so percentage-point change requires both annual ratios. These are common-area estimates displayed on 2022 geometry.

```{r check_join_keys}
# Check keys before any joins to prevent duplicated counts.
for (dataset_name in c(
  "census_data_2010_pessoa", "census_data_2010_domicilio",
  "census_data_2022_basico", "census_data_2022_pessoas",
  "census_data_2022_domicilios"
)) {
  ids <- as.character(get(dataset_name)$code_tract)
  stopifnot(!anyNA(ids), !anyDuplicated(ids))
}

lookup_2010 <- lookup_2010 %>%
  mutate(id_2010 = as.character(id_2010), common_id = as.character(common_id))
lookup_2022 <- lookup_2022 %>%
  mutate(id_2022 = as.character(id_2022), common_id = as.character(common_id))
group_sizes <- group_sizes %>% mutate(common_id = as.character(common_id))
base_geom_2022 <- base_geom_2022 %>%
  mutate(id_2022 = as.character(id_2022), common_id = as.character(common_id))

stopifnot(
  !anyNA(lookup_2010$id_2010), !anyNA(lookup_2022$id_2022),
  !anyDuplicated(st_drop_geometry(lookup_2010) %>% distinct(id_2010, common_id) %>% pull(id_2010)),
  !anyDuplicated(st_drop_geometry(lookup_2022) %>% distinct(id_2022, common_id) %>% pull(id_2022)),
  !anyNA(group_sizes$common_id), !anyDuplicated(group_sizes$common_id)
)
```

```{r black_change_sf}

# ------------------------------------------------------------
# 1. Prepare 2010 data
# ------------------------------------------------------------

black_2010 <- census_data_2010_pessoa %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    pop_2010 = pessoa03_V001,
    black_pop_2010 = pessoa03_V003
  )


# ------------------------------------------------------------
# 2. Prepare 2022 data
# ------------------------------------------------------------

black_2022 <- census_data_2022_basico %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    pop_2022 = V0001
  ) %>%
  left_join(
    census_data_2022_pessoas %>%
      st_drop_geometry() %>%
      transmute(
        id_2022 = as.character(code_tract),
        black_pop_2022 = raca_V01318
      ),
    by = "id_2022"
  )


# ------------------------------------------------------------
# 3. Aggregate 2010 values to common_id
#
# Assumes the lookup defines valid common areas for:
# - 1:1
# - merges
# - splits
# - many-to-many
# ------------------------------------------------------------

black_2010_common <- black_2010 %>%
  left_join(
    lookup_2010 %>%
      st_drop_geometry() %>%
      mutate(
        id_2010 = as.character(id_2010)
      ) %>%
      distinct(
        id_2010,
        common_id
      ),
    by = "id_2010"
  ) %>%
  filter(
    !is.na(common_id)
  ) %>%
  group_by(
    common_id
  ) %>%
  summarise(
    pop_2010 = sum(
      pop_2010,
      na.rm = TRUE
    ),
    black_pop_2010 = sum(
      black_pop_2010,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  mutate(
    black_ratio_2010 = if_else(
      pop_2010 > 0,
      black_pop_2010 / pop_2010,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 4. Aggregate 2022 values to common_id
# ------------------------------------------------------------

black_2022_common <- black_2022 %>%
  left_join(
    lookup_2022 %>%
      st_drop_geometry() %>%
      mutate(
        id_2022 = as.character(id_2022)
      ) %>%
      distinct(
        id_2022,
        common_id
      ),
    by = "id_2022"
  ) %>%
  filter(
    !is.na(common_id)
  ) %>%
  group_by(
    common_id
  ) %>%
  summarise(
    pop_2022 = sum(
      pop_2022,
      na.rm = TRUE
    ),
    black_pop_2022 = sum(
      black_pop_2022,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  mutate(
    black_ratio_2022 = if_else(
      pop_2022 > 0,
      black_pop_2022 / pop_2022,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 5. Join 2010 and 2022 values
# ------------------------------------------------------------

black_change <- black_2010_common %>%
  full_join(
    black_2022_common,
    by = "common_id"
  ) %>%
  left_join(
    group_sizes %>%
      select(
        common_id,
        n_2010,
        n_2022,
        relationship
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 6. Calculate change
#
# Positive = higher Black population share in 2022
# Negative = lower Black population share in 2022
# ------------------------------------------------------------

black_change <- black_change %>%
  mutate(
    black_ratio_change =
      black_ratio_2022 - black_ratio_2010
  )


# ------------------------------------------------------------
# 7. Attach change to the 2022 base geometry
# ------------------------------------------------------------

black_change_sf <- base_geom_2022 %>%
  select(-any_of(c("pop_2010", "black_pop_2010", "black_ratio_2010", "pop_2022", "black_pop_2022", "black_ratio_2022", "black_ratio_change", "black_ratio_change_pp"))) %>%
  mutate(
    id_2022 = as.character(id_2022)
  ) %>%
  left_join(
    black_change %>%
      select(
        common_id,
        pop_2010,
        black_pop_2010,
        black_ratio_2010,
        pop_2022,
        black_pop_2022,
        black_ratio_2022,
        black_ratio_change
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 8. Check results
# ------------------------------------------------------------

black_change %>%
  summary()


black_change %>%
  count(
    relationship
  )


summary(
  black_change$black_ratio_change
)


# ------------------------------------------------------------
# 9. Optional: convert change to percentage points
#
# Example:
# 0.05 = +5 percentage points
# ------------------------------------------------------------

black_change <- black_change %>%
  mutate(
    black_ratio_change_pp =
      black_ratio_change * 100
  )


black_change_sf <- black_change_sf %>%
  left_join(
    black_change %>%
      select(
        common_id,
        black_ratio_change_pp
      ),
    by = "common_id"
  )
```

```{r literacy_sf}
library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 data
# ------------------------------------------------------------

literacy_2010 <- census_data_2010_pessoa %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    
    # Total population aged 15+
    pop_15plus_2010 = rowSums(
      across(
        all_of(sprintf("pessoa13_V%03d", 49:134))
      ),
      na.rm = TRUE
    ),
    
    # Literate population aged 15+
    literate_15plus_2010 = rowSums(
      across(
        all_of(sprintf("pessoa01_V%03d", 12:77))
      ),
      na.rm = TRUE
    )
  )


# ------------------------------------------------------------
# 2. Prepare 2022 data
# ------------------------------------------------------------

literacy_2022 <- census_data_2022_pessoas %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    
    # Total population aged 15+
    pop_15plus_2022 = rowSums(
      across(
        all_of(sprintf("alfabetizacao_V%05d", 644:656))
      ),
      na.rm = TRUE
    ),
    
    # Literate population aged 15+
    literate_15plus_2022 = rowSums(
      across(
        all_of(sprintf("alfabetizacao_V%05d", 748:760))
      ),
      na.rm = TRUE
    )
  )


# ------------------------------------------------------------
# 3. Prepare and check lookup tables
#
# Each tract must belong to exactly one common_id.
# ------------------------------------------------------------

literacy_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id
  ) %>%
  distinct()

literacy_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id
  ) %>%
  distinct()

stopifnot(
  !anyDuplicated(literacy_2010$id_2010),
  !anyDuplicated(literacy_2022$id_2022),
  !anyDuplicated(literacy_lookup_2010$id_2010),
  !anyDuplicated(literacy_lookup_2022$id_2022)
)


# ------------------------------------------------------------
# 4. Aggregate 2010 counts to common_id, then calculate rate
#
# Assumes the lookup tables already define valid common areas
# for 1:1, merges, splits, and many-to-many relationships.
# ------------------------------------------------------------

literacy_2010_common <- literacy_2010 %>%
  left_join(
    literacy_lookup_2010,
    by = "id_2010"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    pop_15plus_2010 = sum(
      pop_15plus_2010,
      na.rm = TRUE
    ),
    
    literate_15plus_2010 = sum(
      literate_15plus_2010,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    literacy_ratio_2010 = if_else(
      pop_15plus_2010 > 0,
      literate_15plus_2010 / pop_15plus_2010,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 5. Aggregate 2022 counts to common_id, then calculate rate
# ------------------------------------------------------------

literacy_2022_common <- literacy_2022 %>%
  left_join(
    literacy_lookup_2022,
    by = "id_2022"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    pop_15plus_2022 = sum(
      pop_15plus_2022,
      na.rm = TRUE
    ),
    
    literate_15plus_2022 = sum(
      literate_15plus_2022,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    literacy_ratio_2022 = if_else(
      pop_15plus_2022 > 0,
      literate_15plus_2022 / pop_15plus_2022,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 6. Join 2010 and 2022 values
# ------------------------------------------------------------

literacy_change <- literacy_2010_common %>%
  full_join(
    literacy_2022_common,
    by = "common_id"
  ) %>%
  left_join(
    group_sizes %>%
      select(
        common_id,
        n_2010,
        n_2022,
        relationship
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 7. Calculate change
#
# Positive = higher literacy rate in 2022
# Negative = lower literacy rate in 2022
#
# Example: 0.05 change = +5 percentage points
# ------------------------------------------------------------

literacy_change <- literacy_change %>%
  mutate(
    literacy_ratio_change =
      literacy_ratio_2022 - literacy_ratio_2010,
    
    literacy_ratio_change_pp =
      literacy_ratio_change * 100
  )


# ------------------------------------------------------------
# 8. Attach change to the 2022 base geometry
# ------------------------------------------------------------

literacy_change_sf <- base_geom_2022 %>%
  select(-any_of(c("pop_15plus_2010", "literate_15plus_2010", "literacy_ratio_2010", "pop_15plus_2022", "literate_15plus_2022", "literacy_ratio_2022", "literacy_ratio_change", "literacy_ratio_change_pp"))) %>%
  mutate(
    id_2022 = as.character(id_2022)
  ) %>%
  left_join(
    literacy_change %>%
      select(
        common_id,
        pop_15plus_2010,
        literate_15plus_2010,
        literacy_ratio_2010,
        pop_15plus_2022,
        literate_15plus_2022,
        literacy_ratio_2022,
        literacy_ratio_change,
        literacy_ratio_change_pp
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 9. Check results
# ------------------------------------------------------------

summary(literacy_change)

literacy_change %>%
  count(relationship)

summary(literacy_change$literacy_ratio_change_pp)

# Missing rates
literacy_change %>%
  summarise(
    missing_2010 = sum(is.na(literacy_ratio_2010)),
    missing_2022 = sum(is.na(literacy_ratio_2022)),
    missing_change = sum(is.na(literacy_ratio_change))
  )

# Inspect out-of-range proportions; these are not automatically removed.
literacy_change %>%
  filter(
    literacy_ratio_2010 < 0 |
      literacy_ratio_2010 > 1 |
      literacy_ratio_2022 < 0 |
      literacy_ratio_2022 > 1
  )
```

```{r rudimentary__sanitation_sf}
library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 data
# ------------------------------------------------------------

rudimentary_sanitation_2010 <- census_data_2010_domicilio %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    
    households_2010 = domicilio01_V002,
    
    rudimentary_sanitation_households_2010 =
      coalesce(as.double(domicilio01_V019), 0) +  # Rudimentary pit
      coalesce(as.double(domicilio01_V020), 0) +  # Ditch
      coalesce(as.double(domicilio01_V021), 0)    # River, lake, or sea
  )


# ------------------------------------------------------------
# 2. Prepare 2022 data
# ------------------------------------------------------------

rudimentary_sanitation_2022 <- census_data_2022_domicilios %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    
    households_2022 = domicilio01_V00001,
    
    rudimentary_sanitation_households_2022 =
      coalesce(as.double(domicilio02_V00312), 0) +  # Rudimentary pit or hole
      coalesce(as.double(domicilio02_V00313), 0) +  # Ditch
      coalesce(as.double(domicilio02_V00314), 0)    # River, lake, stream, or sea
  )


# ------------------------------------------------------------
# 3. Prepare and check lookup tables
#
# Each tract must belong to exactly one common_id.
# ------------------------------------------------------------

rudimentary_sanitation_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id
  ) %>%
  distinct()

rudimentary_sanitation_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id
  ) %>%
  distinct()

stopifnot(
  !anyDuplicated(rudimentary_sanitation_2010$id_2010),
  !anyDuplicated(rudimentary_sanitation_2022$id_2022),
  !anyDuplicated(rudimentary_sanitation_lookup_2010$id_2010),
  !anyDuplicated(rudimentary_sanitation_lookup_2022$id_2022),
  !anyDuplicated(group_sizes$common_id)
)


# ------------------------------------------------------------
# 4. Aggregate 2010 counts, then calculate proportion
#
# Missing counts are ignored during aggregation (na.rm = TRUE).
# ------------------------------------------------------------

rudimentary_sanitation_2010_common <- rudimentary_sanitation_2010 %>%
  left_join(
    rudimentary_sanitation_lookup_2010,
    by = "id_2010"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    households_2010 = sum(
      households_2010,
      na.rm = TRUE
    ),
    
    rudimentary_sanitation_households_2010 = sum(
      rudimentary_sanitation_households_2010,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    rudimentary_sanitation_ratio_2010 = if_else(
      households_2010 > 0,
      rudimentary_sanitation_households_2010 / households_2010,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 5. Aggregate 2022 counts, then calculate proportion
# ------------------------------------------------------------

rudimentary_sanitation_2022_common <- rudimentary_sanitation_2022 %>%
  left_join(
    rudimentary_sanitation_lookup_2022,
    by = "id_2022"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    households_2022 = sum(
      households_2022,
      na.rm = TRUE
    ),
    
    rudimentary_sanitation_households_2022 = sum(
      rudimentary_sanitation_households_2022,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    rudimentary_sanitation_ratio_2022 = if_else(
      households_2022 > 0,
      rudimentary_sanitation_households_2022 / households_2022,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 6. Join years and calculate change
#
# Positive = higher rudimentary sanitation share
# Negative = lower rudimentary sanitation share
# ------------------------------------------------------------

rudimentary_sanitation_change <- rudimentary_sanitation_2010_common %>%
  full_join(
    rudimentary_sanitation_2022_common,
    by = "common_id"
  ) %>%
  left_join(
    group_sizes %>%
      select(
        common_id,
        n_2010,
        n_2022,
        relationship
      ),
    by = "common_id"
  ) %>%
  mutate(
    rudimentary_sanitation_ratio_change =
      rudimentary_sanitation_ratio_2022 -
      rudimentary_sanitation_ratio_2010,
    
    rudimentary_sanitation_ratio_change_pp =
      rudimentary_sanitation_ratio_change * 100
  )


# ------------------------------------------------------------
# 7. Attach change and both proportions to 2022 geometry
# ------------------------------------------------------------

rudimentary_sanitation_change_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "rudimentary_sanitation_households_2010", "rudimentary_sanitation_ratio_2010", "households_2022", "rudimentary_sanitation_households_2022", "rudimentary_sanitation_ratio_2022", "rudimentary_sanitation_ratio_change", "rudimentary_sanitation_ratio_change_pp"))) %>%
  left_join(
    rudimentary_sanitation_change %>%
      select(
        common_id,
        households_2010,
        rudimentary_sanitation_households_2010,
        rudimentary_sanitation_ratio_2010,
        households_2022,
        rudimentary_sanitation_households_2022,
        rudimentary_sanitation_ratio_2022,
        rudimentary_sanitation_ratio_change,
        rudimentary_sanitation_ratio_change_pp
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 8. Separate sf objects for each year's proportion
#
# Both use 2022 geometry and common_id-level values.
# ------------------------------------------------------------

rudimentary_sanitation_2010_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "rudimentary_sanitation_households_2010", "rudimentary_sanitation_ratio_2010", "households_2022", "rudimentary_sanitation_households_2022", "rudimentary_sanitation_ratio_2022", "rudimentary_sanitation_ratio_change", "rudimentary_sanitation_ratio_change_pp"))) %>%
  left_join(
    rudimentary_sanitation_2010_common,
    by = "common_id"
  )

rudimentary_sanitation_2022_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "rudimentary_sanitation_households_2010", "rudimentary_sanitation_ratio_2010", "households_2022", "rudimentary_sanitation_households_2022", "rudimentary_sanitation_ratio_2022", "rudimentary_sanitation_ratio_change", "rudimentary_sanitation_ratio_change_pp"))) %>%
  left_join(
    rudimentary_sanitation_2022_common,
    by = "common_id"
  )


# ------------------------------------------------------------
# 9. Check results
# ------------------------------------------------------------

summary(rudimentary_sanitation_change)

rudimentary_sanitation_change %>%
  count(relationship)

summary(
  rudimentary_sanitation_change$rudimentary_sanitation_ratio_change_pp
)

# Missing proportions and changes
rudimentary_sanitation_change %>%
  summarise(
    missing_2010 = sum(is.na(rudimentary_sanitation_ratio_2010)),
    missing_2022 = sum(is.na(rudimentary_sanitation_ratio_2022)),
    missing_change = sum(is.na(rudimentary_sanitation_ratio_change))
  )

# Inspect out-of-range proportions; these are not automatically removed.
rudimentary_sanitation_change %>%
  filter(
    rudimentary_sanitation_ratio_2010 < 0 |
      rudimentary_sanitation_ratio_2010 > 1 |
      rudimentary_sanitation_ratio_2022 < 0 |
      rudimentary_sanitation_ratio_2022 > 1
  )
```

```{r water_network_sf}

library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 data
# ------------------------------------------------------------

water_network_2010 <- census_data_2010_domicilio %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    
    households_2010 = domicilio01_V002,
    
    water_network_households_2010 = domicilio01_V012
  )


# ------------------------------------------------------------
# 2. Prepare 2022 data
# ------------------------------------------------------------

water_network_2022 <- census_data_2022_domicilios %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    
    households_2022 = domicilio01_V00001,
    
    water_network_households_2022 = domicilio02_V00111
  )


# ------------------------------------------------------------
# 3. Prepare and check lookup tables
#
# Each tract must belong to exactly one common_id.
# ------------------------------------------------------------

water_network_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id
  ) %>%
  distinct()

water_network_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id
  ) %>%
  distinct()

stopifnot(
  !anyDuplicated(water_network_2010$id_2010),
  !anyDuplicated(water_network_2022$id_2022),
  !anyDuplicated(water_network_lookup_2010$id_2010),
  !anyDuplicated(water_network_lookup_2022$id_2022),
  !anyDuplicated(group_sizes$common_id)
)


# ------------------------------------------------------------
# 4. Aggregate 2010 counts, then calculate proportion
#
# Missing counts are ignored during aggregation (na.rm = TRUE).
# ------------------------------------------------------------

water_network_2010_common <- water_network_2010 %>%
  left_join(
    water_network_lookup_2010,
    by = "id_2010"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    households_2010 = sum(
      households_2010,
      na.rm = TRUE
    ),
    
    water_network_households_2010 = sum(
      water_network_households_2010,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    water_network_ratio_2010 = if_else(
      households_2010 > 0,
      water_network_households_2010 / households_2010,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 5. Aggregate 2022 counts, then calculate proportion
# ------------------------------------------------------------

water_network_2022_common <- water_network_2022 %>%
  left_join(
    water_network_lookup_2022,
    by = "id_2022"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    households_2022 = sum(
      households_2022,
      na.rm = TRUE
    ),
    
    water_network_households_2022 = sum(
      water_network_households_2022,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    water_network_ratio_2022 = if_else(
      households_2022 > 0,
      water_network_households_2022 / households_2022,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 6. Join years and calculate change
#
# Positive = higher water-network coverage
# Negative = lower water-network coverage
#
# Example: 0.05 change = +5 percentage points
# ------------------------------------------------------------

water_network_change <- water_network_2010_common %>%
  full_join(
    water_network_2022_common,
    by = "common_id"
  ) %>%
  left_join(
    group_sizes %>%
      select(
        common_id,
        n_2010,
        n_2022,
        relationship
      ),
    by = "common_id"
  ) %>%
  mutate(
    water_network_ratio_change =
      water_network_ratio_2022 - water_network_ratio_2010,
    
    water_network_ratio_change_pp =
      water_network_ratio_change * 100
  )


# ------------------------------------------------------------
# 7. Attach change and both proportions to 2022 geometry
# ------------------------------------------------------------

water_network_change_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "water_network_households_2010", "water_network_ratio_2010", "households_2022", "water_network_households_2022", "water_network_ratio_2022", "water_network_ratio_change", "water_network_ratio_change_pp"))) %>%
  left_join(
    water_network_change %>%
      select(
        common_id,
        households_2010,
        water_network_households_2010,
        water_network_ratio_2010,
        households_2022,
        water_network_households_2022,
        water_network_ratio_2022,
        water_network_ratio_change,
        water_network_ratio_change_pp
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 8. Separate sf objects for each year's proportion
#
# Both use 2022 geometry and common_id-level values.
# ------------------------------------------------------------

water_network_2010_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "water_network_households_2010", "water_network_ratio_2010", "households_2022", "water_network_households_2022", "water_network_ratio_2022", "water_network_ratio_change", "water_network_ratio_change_pp"))) %>%
  left_join(
    water_network_2010_common,
    by = "common_id"
  )

water_network_2022_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "water_network_households_2010", "water_network_ratio_2010", "households_2022", "water_network_households_2022", "water_network_ratio_2022", "water_network_ratio_change", "water_network_ratio_change_pp"))) %>%
  left_join(
    water_network_2022_common,
    by = "common_id"
  )


# ------------------------------------------------------------
# 9. Check results
# ------------------------------------------------------------

summary(water_network_change)

water_network_change %>%
  count(relationship)

summary(water_network_change$water_network_ratio_change_pp)

# Missing proportions and changes
water_network_change %>%
  summarise(
    missing_2010 = sum(is.na(water_network_ratio_2010)),
    missing_2022 = sum(is.na(water_network_ratio_2022)),
    missing_change = sum(is.na(water_network_ratio_change))
  )

# Inspect out-of-range proportions; these are not automatically removed.
water_network_change %>%
  filter(
    water_network_ratio_2010 < 0 |
      water_network_ratio_2010 > 1 |
      water_network_ratio_2022 < 0 |
      water_network_ratio_2022 > 1
  )
```

```{r waste_collection_sf}

library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 and 2022 data
# ------------------------------------------------------------

waste_collection_2010 <- census_data_2010_domicilio %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    households_2010 = domicilio01_V002,
    waste_collection_households_2010 = domicilio01_V035
  )

waste_collection_2022 <- census_data_2022_domicilios %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    households_2022 = domicilio01_V00001,
    
    waste_collection_households_2022 =
      coalesce(as.double(domicilio02_V00397), 0) +  # Direct collection
      coalesce(as.double(domicilio02_V00398), 0)    # Communal containers
  )


# ------------------------------------------------------------
# 2. Prepare and check lookup tables
# ------------------------------------------------------------

waste_collection_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id
  ) %>%
  distinct()

waste_collection_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id
  ) %>%
  distinct()

stopifnot(
  !anyDuplicated(waste_collection_2010$id_2010),
  !anyDuplicated(waste_collection_2022$id_2022),
  !anyDuplicated(waste_collection_lookup_2010$id_2010),
  !anyDuplicated(waste_collection_lookup_2022$id_2022),
  !anyDuplicated(group_sizes$common_id)
)


# ------------------------------------------------------------
# 3. Aggregate 2010 counts, then calculate proportion
#
# Missing counts are ignored during aggregation (na.rm = TRUE).
# ------------------------------------------------------------

waste_collection_2010_common <- waste_collection_2010 %>%
  left_join(
    waste_collection_lookup_2010,
    by = "id_2010"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    households_2010 = sum(households_2010, na.rm = TRUE),
    
    waste_collection_households_2010 = sum(
      waste_collection_households_2010,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    waste_collection_ratio_2010 = if_else(
      households_2010 > 0,
      waste_collection_households_2010 / households_2010,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 4. Aggregate 2022 counts, then calculate proportion
# ------------------------------------------------------------

waste_collection_2022_common <- waste_collection_2022 %>%
  left_join(
    waste_collection_lookup_2022,
    by = "id_2022"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    households_2022 = sum(households_2022, na.rm = TRUE),
    
    waste_collection_households_2022 = sum(
      waste_collection_households_2022,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    waste_collection_ratio_2022 = if_else(
      households_2022 > 0,
      waste_collection_households_2022 / households_2022,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 5. Join years and calculate change
#
# Positive = increased coverage
# ------------------------------------------------------------

waste_collection_change <- waste_collection_2010_common %>%
  full_join(
    waste_collection_2022_common,
    by = "common_id"
  ) %>%
  left_join(
    group_sizes %>%
      select(common_id, n_2010, n_2022, relationship),
    by = "common_id"
  ) %>%
  mutate(
    waste_collection_ratio_change =
      waste_collection_ratio_2022 - waste_collection_ratio_2010,
    
    waste_collection_ratio_change_pp =
      waste_collection_ratio_change * 100
  )


# ------------------------------------------------------------
# 6. Attach change and proportions to 2022 geometry
# ------------------------------------------------------------

waste_collection_change_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "waste_collection_households_2010", "waste_collection_ratio_2010", "households_2022", "waste_collection_households_2022", "waste_collection_ratio_2022", "waste_collection_ratio_change", "waste_collection_ratio_change_pp"))) %>%
  left_join(
    waste_collection_change %>%
      select(
        common_id,
        households_2010,
        waste_collection_households_2010,
        waste_collection_ratio_2010,
        households_2022,
        waste_collection_households_2022,
        waste_collection_ratio_2022,
        waste_collection_ratio_change,
        waste_collection_ratio_change_pp
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 7. Separate sf objects for each year
#
# Both use 2022 geometry and common_id-level proportions.
# ------------------------------------------------------------

waste_collection_2010_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "waste_collection_households_2010", "waste_collection_ratio_2010", "households_2022", "waste_collection_households_2022", "waste_collection_ratio_2022", "waste_collection_ratio_change", "waste_collection_ratio_change_pp"))) %>%
  left_join(
    waste_collection_2010_common,
    by = "common_id"
  )

waste_collection_2022_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "waste_collection_households_2010", "waste_collection_ratio_2010", "households_2022", "waste_collection_households_2022", "waste_collection_ratio_2022", "waste_collection_ratio_change", "waste_collection_ratio_change_pp"))) %>%
  left_join(
    waste_collection_2022_common,
    by = "common_id"
  )


# ------------------------------------------------------------
# 8. Check results
# ------------------------------------------------------------

summary(waste_collection_change$waste_collection_ratio_change_pp)

waste_collection_change %>%
  count(relationship)

waste_collection_change %>%
  summarise(
    missing_2010 = sum(is.na(waste_collection_ratio_2010)),
    missing_2022 = sum(is.na(waste_collection_ratio_2022)),
    missing_change = sum(is.na(waste_collection_ratio_change))
  )

# Inspect out-of-range proportions; these are not automatically removed.
waste_collection_change %>%
  filter(
    waste_collection_ratio_2010 < 0 |
      waste_collection_ratio_2010 > 1 |
      waste_collection_ratio_2022 < 0 |
      waste_collection_ratio_2022 > 1
  )

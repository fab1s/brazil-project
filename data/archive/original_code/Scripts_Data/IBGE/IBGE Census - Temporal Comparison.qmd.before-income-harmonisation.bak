```{r apartment_sf}

library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 data
# ------------------------------------------------------------

apartments_2010 <- census_data_2010_domicilio %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    households_2010 = domicilio01_V002,
    apartments_2010 = domicilio01_V005
  )

# ------------------------------------------------------------
# 2. Prepare 2022 data
# ------------------------------------------------------------

apartments_2022 <- census_data_2022_domicilios %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    households_2022 = domicilio01_V00001,
    apartments_2022 = domicilio01_V00049
  )

# ------------------------------------------------------------
# 3. Prepare lookup tables
# ------------------------------------------------------------

apartments_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id = as.character(common_id)
  ) %>%
  filter(!is.na(id_2010), !is.na(common_id)) %>%
  distinct()

apartments_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id = as.character(common_id)
  ) %>%
  filter(!is.na(id_2022), !is.na(common_id)) %>%
  distinct()

stopifnot(
  !anyDuplicated(apartments_2010$id_2010),
  !anyDuplicated(apartments_2022$id_2022),
  !anyDuplicated(apartments_lookup_2010$id_2010),
  !anyDuplicated(apartments_lookup_2022$id_2022)
)

# ------------------------------------------------------------
# 4. Aggregate 2010 counts and calculate proportion
# ------------------------------------------------------------

apartments_2010_common <- apartments_lookup_2010 %>%
  left_join(apartments_2010, by = "id_2010") %>%
  group_by(common_id) %>%
  summarise(
    households_2010 = if (all(is.na(households_2010))) {
      NA_real_
    } else {
      sum(households_2010, na.rm = TRUE)
    },
    apartments_2010 = sum(apartments_2010, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    apartments_ratio_2010 = if_else(
      households_2010 > 0,
      apartments_2010 / households_2010,
      NA_real_
    )
  )

# ------------------------------------------------------------
# 5. Aggregate 2022 counts and calculate proportion
# ------------------------------------------------------------

apartments_2022_common <- apartments_lookup_2022 %>%
  left_join(apartments_2022, by = "id_2022") %>%
  group_by(common_id) %>%
  summarise(
    households_2022 = if (all(is.na(households_2022))) {
      NA_real_
    } else {
      sum(households_2022, na.rm = TRUE)
    },
    apartments_2022 = sum(apartments_2022, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    apartments_ratio_2022 = if_else(
      households_2022 > 0,
      apartments_2022 / households_2022,
      NA_real_
    )
  )

# ------------------------------------------------------------
# 6. Join years and calculate change
# ------------------------------------------------------------

apartments_change <- apartments_2010_common %>%
  full_join(apartments_2022_common, by = "common_id") %>%
  mutate(
    apartments_ratio_change =
      apartments_ratio_2022 - apartments_ratio_2010,
    apartments_ratio_change_pp =
      apartments_ratio_change * 100
  )

# ------------------------------------------------------------
# 7. Attach values to 2022 geometry
# ------------------------------------------------------------

apartments_fields <- c(
  "households_2010", "apartments_2010", "apartments_ratio_2010",
  "households_2022", "apartments_2022", "apartments_ratio_2022",
  "apartments_ratio_change", "apartments_ratio_change_pp"
)

apartments_change_sf <- base_geom_2022 %>%
  mutate(common_id = as.character(common_id)) %>%
  select(-any_of(apartments_fields)) %>%
  left_join(apartments_change, by = "common_id")

# ------------------------------------------------------------
# 8. Separate annual sf objects
# ------------------------------------------------------------

apartments_2010_sf <- base_geom_2022 %>%
  mutate(common_id = as.character(common_id)) %>%
  select(-any_of(apartments_fields)) %>%
  left_join(apartments_2010_common, by = "common_id")

apartments_2022_sf <- base_geom_2022 %>%
  mutate(common_id = as.character(common_id)) %>%
  select(-any_of(apartments_fields)) %>%
  left_join(apartments_2022_common, by = "common_id")

# ------------------------------------------------------------
# 9. Check results
# ------------------------------------------------------------

summary(apartments_change$apartments_ratio_change_pp)

apartments_change %>%
  summarise(
    missing_2010 = sum(is.na(apartments_ratio_2010)),
    missing_2022 = sum(is.na(apartments_ratio_2022)),
    missing_change = sum(is.na(apartments_ratio_change))
  )

# Should return zero rows
apartments_change %>%
  filter(
    apartments_ratio_2010 < 0 | apartments_ratio_2010 > 1 |
      apartments_ratio_2022 < 0 | apartments_ratio_2022 > 1
  )
```

```{r population_density_sf}

library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 population
# ------------------------------------------------------------

population_2010 <- census_data_2010_pessoa %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    pop_2010 = pessoa03_V001
  )

# ------------------------------------------------------------
# 2. Prepare 2022 population
# ------------------------------------------------------------

population_2022 <- census_data_2022_basico %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    pop_2022 = V0001
  )

# ------------------------------------------------------------
# 3. Prepare lookup tables
# ------------------------------------------------------------

density_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id = as.character(common_id)
  ) %>%
  distinct()

density_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id = as.character(common_id)
  ) %>%
  distinct()

stopifnot(
  !anyDuplicated(population_2010$id_2010),
  !anyDuplicated(population_2022$id_2022),
  !anyDuplicated(density_lookup_2010$id_2010),
  !anyDuplicated(density_lookup_2022$id_2022)
)

# ------------------------------------------------------------
# 4. Aggregate population to common_id
#
# Preserve missing totals when every value is missing.
# Otherwise, sum the available counts.
# ------------------------------------------------------------

population_2010_common <- population_2010 %>%
  left_join(density_lookup_2010, by = "id_2010") %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    pop_2010 = if (all(is.na(pop_2010))) {
      NA_real_
    } else {
      sum(pop_2010, na.rm = TRUE)
    },
    .groups = "drop"
  )

population_2022_common <- population_2022 %>%
  left_join(density_lookup_2022, by = "id_2022") %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    pop_2022 = if (all(is.na(pop_2022))) {
      NA_real_
    } else {
      sum(pop_2022, na.rm = TRUE)
    },
    .groups = "drop"
  )

# ------------------------------------------------------------
# 5. Calculate comparison-area size in km²
#
# Dissolve component polygons before measuring.
# EPSG:6933 is an equal-area projection.
# This step may take some time for all of Brazil.
# ------------------------------------------------------------

density_area_common <- base_geom_2022 %>%
  mutate(
    common_id = as.character(common_id)
  ) %>%
  filter(!is.na(common_id)) %>%
  select(common_id) %>%
  st_make_valid() %>%
  st_transform(6933) %>%
  group_by(common_id) %>%
  summarise(
    .groups = "drop"
  ) %>%
  mutate(
    area_km2 = as.numeric(st_area(.)) / 1e6
  ) %>%
  st_drop_geometry()

# ------------------------------------------------------------
# 6. Join years and calculate population density
#
# Density = population / area in km²
# ------------------------------------------------------------

population_density_change <- population_2010_common %>%
  full_join(
    population_2022_common,
    by = "common_id"
  ) %>%
  left_join(
    density_area_common,
    by = "common_id"
  ) %>%
  mutate(
    population_density_2010 = if_else(
      area_km2 > 0,
      pop_2010 / area_km2,
      NA_real_
    ),
    population_density_2022 = if_else(
      area_km2 > 0,
      pop_2022 / area_km2,
      NA_real_
    )
  )

# ------------------------------------------------------------
# 7. Calculate change
#
# Absolute change: people per km²
# Percentage change: relative to 2010
# ------------------------------------------------------------

population_density_change <- population_density_change %>%
  mutate(
    population_density_change =
      population_density_2022 - population_density_2010,
    
    population_density_change_pct = if_else(
      population_density_2010 > 0,
      100 * (
        population_density_2022 / population_density_2010 - 1
      ),
      NA_real_
    )
  )

# ------------------------------------------------------------
# 8. Attach results to the 2022 geometry
#
# Each polygon displays its common-area density.
# ------------------------------------------------------------

population_density_change_sf <- base_geom_2022 %>%
  mutate(
    common_id = as.character(common_id)
  ) %>%
  left_join(
    population_density_change,
    by = "common_id"
  )

# ------------------------------------------------------------
# 9. Check results
# ------------------------------------------------------------

population_density_change_sf %>%
  st_drop_geometry() %>%
  summarise(
    total_polygons = n(),
    missing_2010 = sum(is.na(population_density_2010)),
    missing_2022 = sum(is.na(population_density_2022)),
    missing_change = sum(is.na(population_density_change))
  )

summary(
  population_density_change$population_density_change
)
```


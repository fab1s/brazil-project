  left_join(
    black_brown_lookup_2010,
    by = "id_2010"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    pop_2010 = sum(pop_2010, na.rm = TRUE),

    black_brown_pop_2010 = sum(
      black_brown_pop_2010,
      na.rm = TRUE
    ),

    .groups = "drop"
  ) %>%
  mutate(
    black_brown_ratio_2010 = if_else(
      pop_2010 > 0,
      black_brown_pop_2010 / pop_2010,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 4. Aggregate 2022 counts, then calculate proportion
# ------------------------------------------------------------

black_brown_2022_common <- black_brown_2022 %>%
  left_join(
    black_brown_lookup_2022,
    by = "id_2022"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    pop_2022 = sum(pop_2022, na.rm = TRUE),

    black_brown_pop_2022 = sum(
      black_brown_pop_2022,
      na.rm = TRUE
    ),

    .groups = "drop"
  ) %>%
  mutate(
    black_brown_ratio_2022 = if_else(
      pop_2022 > 0,
      black_brown_pop_2022 / pop_2022,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 5. Join years and calculate change
#
# Positive = higher combined Black and Brown share in 2022
# ------------------------------------------------------------

black_brown_change <- black_brown_2010_common %>%
  full_join(
    black_brown_2022_common,
    by = "common_id"
  ) %>%
  left_join(
    group_sizes %>%
      select(common_id, n_2010, n_2022, relationship),
    by = "common_id"
  ) %>%
  mutate(
    black_brown_ratio_change =
      black_brown_ratio_2022 - black_brown_ratio_2010,

    black_brown_ratio_change_pp =
      black_brown_ratio_change * 100
  )


# ------------------------------------------------------------
# 6. Attach proportions and change to 2022 geometry
# ------------------------------------------------------------

black_brown_sf <- base_geom_2022 %>%
  select(-any_of(c("pop_2010", "black_brown_pop_2010", "black_brown_ratio_2010", "pop_2022", "black_brown_pop_2022", "black_brown_ratio_2022", "black_brown_ratio_change", "black_brown_ratio_change_pp"))) %>%
  select(-any_of(c("pop_2010", "brown_pop_2010", "brown_ratio_2010", "pop_2022", "brown_pop_2022", "brown_ratio_2022", "brown_ratio_change", "brown_ratio_change_pp"))) %>%
  left_join(
    black_brown_change %>%
      select(
        common_id,
        pop_2010,
        black_brown_pop_2010,
        black_brown_ratio_2010,
        pop_2022,
        black_brown_pop_2022,
        black_brown_ratio_2022,
        black_brown_ratio_change,
        black_brown_ratio_change_pp
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 7. Separate sf objects for each year
#
# Both use 2022 geometry and common_id-level proportions.
# ------------------------------------------------------------

black_brown_2010_sf <- base_geom_2022 %>%
  select(-any_of(c("pop_2010", "black_brown_pop_2010", "black_brown_ratio_2010", "pop_2022", "black_brown_pop_2022", "black_brown_ratio_2022", "black_brown_ratio_change", "black_brown_ratio_change_pp"))) %>%
  select(-any_of(c("pop_2010", "brown_pop_2010", "brown_ratio_2010", "pop_2022", "brown_pop_2022", "brown_ratio_2022", "brown_ratio_change", "brown_ratio_change_pp"))) %>%
  left_join(black_brown_2010_common, by = "common_id")

black_brown_2022_sf <- base_geom_2022 %>%
  select(-any_of(c("pop_2010", "black_brown_pop_2010", "black_brown_ratio_2010", "pop_2022", "black_brown_pop_2022", "black_brown_ratio_2022", "black_brown_ratio_change", "black_brown_ratio_change_pp"))) %>%
  select(-any_of(c("pop_2010", "brown_pop_2010", "brown_ratio_2010", "pop_2022", "brown_pop_2022", "brown_ratio_2022", "brown_ratio_change", "brown_ratio_change_pp"))) %>%
  left_join(black_brown_2022_common, by = "common_id")


# ------------------------------------------------------------
# 8. Check results
# ------------------------------------------------------------

summary(black_brown_change$black_brown_ratio_change_pp)

black_brown_change %>%
  count(relationship)

black_brown_change %>%
  summarise(
    missing_2010 = sum(is.na(black_brown_ratio_2010)),
    missing_2022 = sum(is.na(black_brown_ratio_2022)),
    missing_change = sum(is.na(black_brown_ratio_change))
  )

# Inspect out-of-range proportions; these are not automatically removed.
black_brown_change %>%
  filter(
    black_brown_ratio_2010 < 0 |
      black_brown_ratio_2010 > 1 |
      black_brown_ratio_2022 < 0 |
      black_brown_ratio_2022 > 1
  )
```

Only available for 1:1 harmonized census tracts.

```{r income_sf}

library(dplyr)
library(sf)
library(readxl)
library(censobr)

# ------------------------------------------------------------
# 1. Read INPC from your Excel file
#    I4 = July 2010; EW4 = July 2022
# ------------------------------------------------------------

inpc_file <- paste0(
  "/Users/fa4850sc/Library/CloudStorage/",
  "OneDrive-LundUniversity/Brazil Project/",
  "Scripts_Data/IBGE/Data/INPC Inflation 2010-2022.xlsx"
)

inpc_2010 <- read_excel(
  inpc_file,
  range = "I4",
  col_names = FALSE
)[[1]] %>%
  as.numeric()

inpc_2022 <- read_excel(
  inpc_file,
  range = "EW4",
  col_names = FALSE
)[[1]] %>%
  as.numeric()

stopifnot(
  length(inpc_2010) == 1,
  length(inpc_2022) == 1,
  is.finite(inpc_2010),
  is.finite(inpc_2022),
  inpc_2010 > 0,
  inpc_2022 > 0
)

inflation_factor <- inpc_2022 / inpc_2010

# ------------------------------------------------------------
# 2. Load income data
# ------------------------------------------------------------

census_data_2010_basico <- read_tracts(
  year = 2010,
  dataset = "Basico",
  as_data_frame = TRUE
)

census_data_2022_responsavelrenda <- read_tracts(
  year = 2022,
  dataset = "ResponsavelRenda",
  as_data_frame = TRUE
)

# Find the exact column, with or without a table prefix.
income_column <- function(data, code) {
  matches <- grep(
    paste0("(^|_)", code, "$"),
    names(data),
    value = TRUE,
    ignore.case = TRUE
  )
  
  if (length(matches) != 1) {
    stop("Could not uniquely identify income variable ", code)
  }
  
  matches
}

income_var_2010 <- income_column(
  census_data_2010_basico, "V007"
)

income_var_2022 <- income_column(
  census_data_2022_responsavelrenda, "V06004"
)

# ------------------------------------------------------------
# 3. Prepare annual mean income
#    Both years expressed in July 2022 reais
# ------------------------------------------------------------

income_2010 <- census_data_2010_basico %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    income_2010_nominal = as.numeric(.data[[income_var_2010]])
  ) %>%
  mutate(
    income_2010_nominal = if_else(
      is.finite(income_2010_nominal) &
        income_2010_nominal >= 0,
      income_2010_nominal,
      NA_real_
    ),
    income_2010 = income_2010_nominal * inflation_factor
  )

income_2022 <- census_data_2022_responsavelrenda %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    income_2022 = as.numeric(.data[[income_var_2022]])
  ) %>%
  mutate(
    income_2022 = if_else(
      is.finite(income_2022) & income_2022 >= 0,
      income_2022,
      NA_real_
    )
  )

# ------------------------------------------------------------
# 4. Prepare lookup tables
# ------------------------------------------------------------

income_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id = as.character(common_id)
  ) %>%
  filter(!is.na(id_2010), !is.na(common_id)) %>%
  distinct()

income_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id = as.character(common_id)
  ) %>%
  filter(!is.na(id_2022), !is.na(common_id)) %>%
  distinct()

stopifnot(
  !anyDuplicated(income_2010$id_2010),
  !anyDuplicated(income_2022$id_2022),
  !anyDuplicated(income_lookup_2010$id_2010),
  !anyDuplicated(income_lookup_2022$id_2022)
)

# ------------------------------------------------------------
# 5. Select 1:1 common areas
#    Do not average means across multiple tracts
# ------------------------------------------------------------

income_comparable_areas <- income_lookup_2010 %>%
  count(common_id, name = "n_2010") %>%
  inner_join(
    income_lookup_2022 %>%
      count(common_id, name = "n_2022"),
    by = "common_id"
  ) %>%
  filter(n_2010 == 1, n_2022 == 1)

# ------------------------------------------------------------
# 6. Join years and calculate real income change
# ------------------------------------------------------------

income_change <- income_comparable_areas %>%
  left_join(
    income_lookup_2010,
    by = "common_id"
  ) %>%
  left_join(
    income_2010,
    by = "id_2010"
  ) %>%
  left_join(
    income_lookup_2022,
    by = "common_id"
  ) %>%
  left_join(
    income_2022,
    by = "id_2022"
  ) %>%
  mutate(
    income_change_brl = income_2022 - income_2010,
    income_change_pct = if_else(
      income_2010 > 0,
      (income_2022 / income_2010 - 1) * 100,
      NA_real_
    )
  )

# ------------------------------------------------------------
# 7. Attach comparable income values to 2022 geometry
#    Other areas retain geometry but have missing estimates
# ------------------------------------------------------------

income_change_sf <- base_geom_2022 %>%
  mutate(
    common_id = as.character(common_id)
  ) %>%
  select(
    -any_of(c(
      "income_2010_nominal",
      "income_2010",
      "income_2022",
      "income_change_brl",
      "income_change_pct"
    ))
  ) %>%
  left_join(
    income_change %>%
      select(
        common_id,
        income_2010_nominal,
        income_2010,
        income_2022,
        income_change_brl,
        income_change_pct
      ),
    by = "common_id"
  )

# ------------------------------------------------------------
# 8. Separate 2022 income map, including all available tracts
# ------------------------------------------------------------

income_2022_sf <- base_geom_2022 %>%
  mutate(
    id_2022 = as.character(id_2022)
  ) %>%
  select(-any_of("income_2022")) %>%
  left_join(
    income_2022,
    by = "id_2022"
  )

# ------------------------------------------------------------
# 9. Check results
# ------------------------------------------------------------

inflation_factor

income_change %>%
  summarise(
    comparable_areas = n(),
    available_2010 = sum(!is.na(income_2010)),
    available_2022 = sum(!is.na(income_2022)),
    available_change = sum(!is.na(income_change_pct))
  )

summary(income_change$income_change_pct)
```

```{r houses_sf}

library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 data
# ------------------------------------------------------------

houses_2010 <- census_data_2010_domicilio %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    households_2010 = domicilio01_V002,
    houses_2010 = domicilio01_V003
  )

# ------------------------------------------------------------
# 2. Prepare 2022 data
# ------------------------------------------------------------

houses_2022 <- census_data_2022_domicilios %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    households_2022 = domicilio01_V00001,
    houses_2022 = domicilio01_V00047
  )

# ------------------------------------------------------------
# 3. Prepare lookup tables
# ------------------------------------------------------------

houses_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id = as.character(common_id)
  ) %>%
  filter(!is.na(id_2010), !is.na(common_id)) %>%
  distinct()

houses_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id = as.character(common_id)
  ) %>%
  filter(!is.na(id_2022), !is.na(common_id)) %>%
  distinct()

stopifnot(
  !anyDuplicated(houses_2010$id_2010),
  !anyDuplicated(houses_2022$id_2022),
  !anyDuplicated(houses_lookup_2010$id_2010),
  !anyDuplicated(houses_lookup_2022$id_2022)
)

# ------------------------------------------------------------
# 4. Aggregate 2010 counts and calculate proportion
# ------------------------------------------------------------

houses_2010_common <- houses_lookup_2010 %>%
  left_join(houses_2010, by = "id_2010") %>%
  group_by(common_id) %>%
  summarise(
    households_2010 = if (all(is.na(households_2010))) {
      NA_real_
    } else {
      sum(households_2010, na.rm = TRUE)
    },
    houses_2010 = sum(houses_2010, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    houses_ratio_2010 = if_else(
      households_2010 > 0,
      houses_2010 / households_2010,
      NA_real_
    )
  )

# ------------------------------------------------------------
# 5. Aggregate 2022 counts and calculate proportion
# ------------------------------------------------------------

houses_2022_common <- houses_lookup_2022 %>%
  left_join(houses_2022, by = "id_2022") %>%
  group_by(common_id) %>%
  summarise(
    households_2022 = if (all(is.na(households_2022))) {
      NA_real_
    } else {
      sum(households_2022, na.rm = TRUE)
    },
    houses_2022 = sum(houses_2022, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    houses_ratio_2022 = if_else(
      households_2022 > 0,
      houses_2022 / households_2022,
      NA_real_
    )
  )

# ------------------------------------------------------------
# 6. Join years and calculate change
# ------------------------------------------------------------

houses_change <- houses_2010_common %>%
  full_join(houses_2022_common, by = "common_id") %>%
  mutate(
    houses_ratio_change =
      houses_ratio_2022 - houses_ratio_2010,
    houses_ratio_change_pp =
      houses_ratio_change * 100
  )

# ------------------------------------------------------------
# 7. Attach values to 2022 geometry
# ------------------------------------------------------------

houses_fields <- c(
  "households_2010", "houses_2010", "houses_ratio_2010",
  "households_2022", "houses_2022", "houses_ratio_2022",
  "houses_ratio_change", "houses_ratio_change_pp"
)

houses_change_sf <- base_geom_2022 %>%
  mutate(common_id = as.character(common_id)) %>%
  select(-any_of(houses_fields)) %>%
  left_join(houses_change, by = "common_id")

# ------------------------------------------------------------
# 8. Separate annual sf objects
# ------------------------------------------------------------

houses_2010_sf <- base_geom_2022 %>%
  mutate(common_id = as.character(common_id)) %>%
  select(-any_of(houses_fields)) %>%
  left_join(houses_2010_common, by = "common_id")

houses_2022_sf <- base_geom_2022 %>%
  mutate(common_id = as.character(common_id)) %>%
  select(-any_of(houses_fields)) %>%
  left_join(houses_2022_common, by = "common_id")

# ------------------------------------------------------------
# 9. Check results
# ------------------------------------------------------------

summary(houses_change$houses_ratio_change_pp)

houses_change %>%
  summarise(
    missing_2010 = sum(is.na(houses_ratio_2010)),
    missing_2022 = sum(is.na(houses_ratio_2022)),
    missing_change = sum(is.na(houses_ratio_change))
  )

# Should return zero rows
houses_change %>%
  filter(
    houses_ratio_2010 < 0 | houses_ratio_2010 > 1 |
      houses_ratio_2022 < 0 | houses_ratio_2022 > 1
  )
```

```{r village_condo_sf}

library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 data

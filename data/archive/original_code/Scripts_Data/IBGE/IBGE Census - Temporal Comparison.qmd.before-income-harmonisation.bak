```{r sewer_septic_sf}

library(dplyr)
library(sf)

# ------------------------------------------------------------
# 1. Prepare 2010 and 2022 data
# ------------------------------------------------------------

sewer_septic_2010 <- census_data_2010_domicilio %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(code_tract),
    households_2010 = domicilio01_V002,
    
    sewer_septic_households_2010 =
      coalesce(as.double(domicilio01_V017), 0) +  # General sewer or stormwater network
      coalesce(as.double(domicilio01_V018), 0)    # Septic system
  )

sewer_septic_2022 <- census_data_2022_domicilios %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(code_tract),
    households_2022 = domicilio01_V00001,
    
    sewer_septic_households_2022 =
      coalesce(as.double(domicilio02_V00309), 0) +  # General or stormwater network
      coalesce(as.double(domicilio02_V00310), 0) +  # Septic/filter system connected to network
      coalesce(as.double(domicilio02_V00311), 0)    # Septic/filter system not connected to network
  )


# ------------------------------------------------------------
# 2. Prepare and check lookup tables
# ------------------------------------------------------------

sewer_septic_lookup_2010 <- lookup_2010 %>%
  st_drop_geometry() %>%
  transmute(
    id_2010 = as.character(id_2010),
    common_id
  ) %>%
  distinct()

sewer_septic_lookup_2022 <- lookup_2022 %>%
  st_drop_geometry() %>%
  transmute(
    id_2022 = as.character(id_2022),
    common_id
  ) %>%
  distinct()

stopifnot(
  !anyDuplicated(sewer_septic_2010$id_2010),
  !anyDuplicated(sewer_septic_2022$id_2022),
  !anyDuplicated(sewer_septic_lookup_2010$id_2010),
  !anyDuplicated(sewer_septic_lookup_2022$id_2022),
  !anyDuplicated(group_sizes$common_id)
)


# ------------------------------------------------------------
# 3. Aggregate 2010 counts, then calculate proportion
#
# Missing counts are ignored during aggregation (na.rm = TRUE).
# ------------------------------------------------------------

sewer_septic_2010_common <- sewer_septic_2010 %>%
  left_join(
    sewer_septic_lookup_2010,
    by = "id_2010"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    households_2010 = sum(households_2010, na.rm = TRUE),
    
    sewer_septic_households_2010 = sum(
      sewer_septic_households_2010,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    sewer_septic_ratio_2010 = if_else(
      households_2010 > 0,
      sewer_septic_households_2010 / households_2010,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 4. Aggregate 2022 counts, then calculate proportion
# ------------------------------------------------------------

sewer_septic_2022_common <- sewer_septic_2022 %>%
  left_join(
    sewer_septic_lookup_2022,
    by = "id_2022"
  ) %>%
  filter(!is.na(common_id)) %>%
  group_by(common_id) %>%
  summarise(
    households_2022 = sum(households_2022, na.rm = TRUE),
    
    sewer_septic_households_2022 = sum(
      sewer_septic_households_2022,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  ) %>%
  mutate(
    sewer_septic_ratio_2022 = if_else(
      households_2022 > 0,
      sewer_septic_households_2022 / households_2022,
      NA_real_
    )
  )


# ------------------------------------------------------------
# 5. Join years and calculate change
#
# Positive = increased coverage
# ------------------------------------------------------------

sewer_septic_change <- sewer_septic_2010_common %>%
  full_join(
    sewer_septic_2022_common,
    by = "common_id"
  ) %>%
  left_join(
    group_sizes %>%
      select(common_id, n_2010, n_2022, relationship),
    by = "common_id"
  ) %>%
  mutate(
    sewer_septic_ratio_change =
      sewer_septic_ratio_2022 - sewer_septic_ratio_2010,
    
    sewer_septic_ratio_change_pp =
      sewer_septic_ratio_change * 100
  )


# ------------------------------------------------------------
# 6. Attach change and proportions to 2022 geometry
# ------------------------------------------------------------

sewer_septic_change_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "sewer_septic_households_2010", "sewer_septic_ratio_2010", "households_2022", "sewer_septic_households_2022", "sewer_septic_ratio_2022", "sewer_septic_ratio_change", "sewer_septic_ratio_change_pp"))) %>%
  left_join(
    sewer_septic_change %>%
      select(
        common_id,
        households_2010,
        sewer_septic_households_2010,
        sewer_septic_ratio_2010,
        households_2022,
        sewer_septic_households_2022,
        sewer_septic_ratio_2022,
        sewer_septic_ratio_change,
        sewer_septic_ratio_change_pp
      ),
    by = "common_id"
  )


# ------------------------------------------------------------
# 7. Separate sf objects for each year
#
# Both use 2022 geometry and common_id-level proportions.
# ------------------------------------------------------------

sewer_septic_2010_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "sewer_septic_households_2010", "sewer_septic_ratio_2010", "households_2022", "sewer_septic_households_2022", "sewer_septic_ratio_2022", "sewer_septic_ratio_change", "sewer_septic_ratio_change_pp"))) %>%
  left_join(
    sewer_septic_2010_common,
    by = "common_id"
  )

sewer_septic_2022_sf <- base_geom_2022 %>%
  select(-any_of(c("households_2010", "sewer_septic_households_2010", "sewer_septic_ratio_2010", "households_2022", "sewer_septic_households_2022", "sewer_septic_ratio_2022", "sewer_septic_ratio_change", "sewer_septic_ratio_change_pp"))) %>%
  left_join(
    sewer_septic_2022_common,
    by = "common_id"
  )


# ------------------------------------------------------------
# 8. Check results
# ------------------------------------------------------------

summary(sewer_septic_change$sewer_septic_ratio_change_pp)

sewer_septic_change %>%
  count(relationship)

sewer_septic_change %>%
  summarise(
    missing_2010 = sum(is.na(sewer_septic_ratio_2010)),
    missing_2022 = sum(is.na(sewer_septic_ratio_2022)),
    missing_change = sum(is.na(sewer_septic_ratio_change))
  )

# Inspect out-of-range proportions; these are not automatically removed.
sewer_septic_change %>%
  filter(
    sewer_septic_ratio_2010 < 0 |
      sewer_septic_ratio_2010 > 1 |
      sewer_septic_ratio_2022 < 0 |
      sewer_septic_ratio_2022 > 1
  )
